{
  "extends": [
    "github:rcwbr/release-it-docker/file-bumper#0.8.0"
  ],
  "hooks": {
    "after:bump": [
      "docker run --rm -v ${GITHUB_WORKSPACE}:${GITHUB_WORKSPACE} -w ${GITHUB_WORKSPACE} ghcr.io/astral-sh/uv:0.9.11-python3.12-trixie-slim uv version ${version}"
    ]
  },
  "plugins": {
    "@release-it/bumper": {
      "out": [
        {
          "file": ".github/workflows/mender-docker-lifecycle-helper.yaml",
          "type": "text/plain"
        },
        {
          "file": "examples/ci/docker-compose.yaml",
          "type": "text/plain"
        },
        {
          "file": "mender-docker-lifecycle-helper-launcher",
          "type": "text/plain"
        }
      ]
    }
  }
}
